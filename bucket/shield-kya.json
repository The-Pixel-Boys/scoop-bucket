{
    "version": "0.32.5",
    "description": "Audit trail and traceability for AI agents. See what every coding agent did, block risky calls, ask a human for approval, and prove it with signed trust checks.",
    "homepage": "https://shield-agent.com/install",
    "license": "MIT",
    "depends": "nodejs",
    "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-0.32.5.tgz",
    "hash": "sha256:14ff57e710b367749291547f19c5d6dcf6379766aeeb3f5ad82d60c8fdb685f2",
    "extract_dir": "package",
    "pre_install": [
        "Set-Content -Path \"$dir\\kya.cmd\" -Value '@node \"%~dp0dist\\cli.js\" %*' -Encoding Ascii"
    ],
    "post_install": [
        "Push-Location \"$dir\"",
        "npm install --omit=dev --no-audit --no-fund",
        "$npmExit = $LASTEXITCODE",
        "Pop-Location",
        "if ($npmExit -ne 0) { throw \"npm install failed with exit code $npmExit\" }"
    ],
    "bin": [
        "kya.cmd",
        [
            "kya.cmd",
            "shield-kya"
        ]
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@shield-agent/kya",
        "jsonpath": "$.dist-tags.latest"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-$version.tgz"
    }
}
