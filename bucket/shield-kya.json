{
    "version": "0.35.8",
    "description": "Stops your coding agent from deleting, leaking or dropping things. Records everything else.",
    "homepage": "https://shield-agent.com/install",
    "license": "MIT",
    "depends": "nodejs",
    "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-0.35.8.tgz",
    "hash": "sha256:44a03f66e0cf73a9a4699bf99bd4443a79f6e801ee61831eb929157bb69575de",
    "extract_dir": "package",
    "pre_install": [
        "Set-Content -Path \"$dir\\kya.cmd\" -Value '@node \"%~dp0dist\\cli.js\" %*' -Encoding Ascii"
    ],
    "post_install": [
        "Push-Location \"$dir\"",
        "npm install --omit=dev --no-audit --no-fund",
        "$npmExit = $LASTEXITCODE",
        "Pop-Location",
        "if ($npmExit -ne 0) { throw \"npm install failed with exit code $npmExit\" }"
    ],
    "bin": [
        "kya.cmd",
        [
            "kya.cmd",
            "shield-kya"
        ]
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@shield-agent/kya",
        "jsonpath": "$.dist-tags.latest"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-$version.tgz"
    }
}
