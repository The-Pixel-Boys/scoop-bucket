{
    "version": "0.33.6",
    "description": "Audit trail and traceability for AI agents. See what every coding agent did and check each tool call against policy.",
    "homepage": "https://shield-agent.com/install",
    "license": "MIT",
    "depends": "nodejs",
    "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-0.33.6.tgz",
    "hash": "sha256:66cf78a0a187c4e04ac6270d46948ce2d0efb09d6b629e37497d085dde0e895a",
    "extract_dir": "package",
    "pre_install": [
        "Set-Content -Path \"$dir\\kya.cmd\" -Value '@node \"%~dp0dist\\cli.js\" %*' -Encoding Ascii"
    ],
    "post_install": [
        "Push-Location \"$dir\"",
        "npm install --omit=dev --no-audit --no-fund",
        "$npmExit = $LASTEXITCODE",
        "Pop-Location",
        "if ($npmExit -ne 0) { throw \"npm install failed with exit code $npmExit\" }"
    ],
    "bin": [
        "kya.cmd",
        [
            "kya.cmd",
            "shield-kya"
        ]
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@shield-agent/kya",
        "jsonpath": "$.dist-tags.latest"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-$version.tgz"
    }
}
